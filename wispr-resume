#!/usr/bin/env bash
# Resume the saved account and batch without repeating completed accounts.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/lib/env.sh"
if ! python3 "${SCRIPT_DIR}/lib/job-lock.py" --is-held "$SCRIPT_DIR"; then
  exec python3 "${SCRIPT_DIR}/lib/job-lock.py" "$SCRIPT_DIR" "${SCRIPT_DIR}/wispr-resume" "$@"
fi
node "${SCRIPT_DIR}/lib/referral-status.mjs" "$SCRIPT_DIR/data/pending-signup.json"
REQUIRE_REFERRAL=$(python3 - "$SCRIPT_DIR/data/pending-signup.json" <<'PYREQUIRE'
import json, sys
try:
    with open(sys.argv[1]) as stream:
        print(int(bool(json.load(stream).get('requireReferral'))))
except FileNotFoundError:
    print(0)
PYREQUIRE
)
export REQUIRE_REFERRAL
HEADER=$(python3 - "$SCRIPT_DIR" "${1:-}" <<'PYCONFIG'
import json, sys
from pathlib import Path
root, task = sys.argv[1:]
print("const dataDir = " + json.dumps(root + "/data") + ";")
print("const requestedTask = " + json.dumps(task) + ";")
print("const moduleUrl = " + json.dumps(Path(root, "lib/web-auth.mjs").as_uri()) + ";")
PYCONFIG
)
ego-browser nodejs <<EOF
${HEADER}
const { readJson, runSignup } = await import(moduleUrl);
const pending = await readJson(dataDir + '/pending-signup.json');
if (!pending) throw new Error('No saved signup to resume');
if (requestedTask && ![String(pending.taskSpaceId), pending.taskSpace].includes(requestedTask)) throw new Error('Task does not match the saved signup');
if (!pending.completed && (!pending.verified || (pending.requireReferral && !pending.signupSynced))) {
  const space = (await listTaskSpaces()).find(s => s.id === pending.taskSpaceId);
  let task;
  if (space?.ownership === 'agentDelegatedToUser') task = await takeOverTaskSpace(pending.taskSpaceId);
  else if (space?.ownership === 'user') task = await claimTaskSpace(pending.taskSpaceId);
  else task = await taskSpace(space ? pending.taskSpaceId : pending.taskSpace || 'wispr-signup');
  process.exitCode = await runSignup({ ...pending, resume: true, pageAvailable: !!space }, task);
}
EOF
FIELDS=$(python3 - "$SCRIPT_DIR/data/pending-signup.json" <<'PYFIELDS'
import json, sys
p = json.load(open(sys.argv[1]))
if not p.get('verified'):
    raise SystemExit('ERROR: The saved account is not verified')
values = [p[k] for k in ('email', 'password', 'targetWords', 'remainingAccounts', 'referralCode')]
values += [str(bool(p.get('skipDictation'))).lower(), str(bool(p.get('completed'))).lower()]
print("\t".join(str(value) for value in values))
PYFIELDS
)
IFS=$'\t' read -r EMAIL PASSWORD WORDS REMAINING REFERRAL_CODE SKIP_DICTATION COMPLETED <<< "$FIELDS"
if [ "$COMPLETED" != "true" ]; then
  if [ "$SKIP_DICTATION" != "true" ]; then
    TARGET_WORDS="$WORDS" "${SCRIPT_DIR}/wispr-complete-flow" "$EMAIL" "$PASSWORD"
  fi
  REMAINING=$((REMAINING - 1))
  python3 - "$SCRIPT_DIR/data/pending-signup.json" "$REMAINING" <<'PYCOMPLETE'
import json, os, sys, tempfile
path, remaining = sys.argv[1:]
with open(path) as stream:
    pending = json.load(stream)
pending.update(completed=True, remainingAccounts=max(0, int(remaining)))
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.pending-')
with os.fdopen(fd, 'w') as stream:
    json.dump(pending, stream, indent=2)
os.replace(temporary, path)
PYCOMPLETE
fi
if [ "$REMAINING" -gt 0 ]; then
  export WISPR_CONTINUE_BATCH=1
  if [ "$SKIP_DICTATION" = "true" ]; then
    exec env REFERRAL_CODE="$REFERRAL_CODE" TARGET_WORDS="$WORDS" \
      "${SCRIPT_DIR}/wispr-test" "$REMAINING" --no-dictation
  fi
  exec "${SCRIPT_DIR}/wispr-run" --accounts "$REMAINING" --words "$WORDS" --referral "$REFERRAL_CODE" --foreground
fi
bash "${SCRIPT_DIR}/lib/close-ego-wispr-spaces.sh"
echo "Saved batch complete; no remaining accounts."
