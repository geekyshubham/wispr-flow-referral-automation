#!/usr/bin/env bash
# Complete isolated referral flow: login test account in separate Wispr profile + W-word dictation
# Success is SERVER /history/stats total_words (referral source of truth), not local cache.
# Usage: TARGET_WORDS=2100 ./wispr-complete-flow [email] [password]
# Credentials must be supplied explicitly.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib/env.sh"
if ! python3 "${SCRIPT_DIR}/lib/job-lock.py" --is-held "$SCRIPT_DIR"; then
  exec python3 "${SCRIPT_DIR}/lib/job-lock.py" "$SCRIPT_DIR" "${SCRIPT_DIR}/wispr-complete-flow" "$@"
fi
EMAIL="${1:-}"
PASSWORD="${2:-}"
if [ -z "$EMAIL" ] || [ -z "$PASSWORD" ]; then
  echo "Usage: $0 <email> <password>"
  exit 1
fi
EMAIL=$(python3 - "$EMAIL" <<'PYNORMALIZE'
import sys
print(sys.argv[1].strip().lower())
PYNORMALIZE
)
PROFILE_KEY=$(python3 "${SCRIPT_DIR}/lib/verify-runtime-isolation.py" --key "$EMAIL")
PROFILE_DIR="${SCRIPT_DIR}/profiles/${PROFILE_KEY}"
WISPR_APP_PATH=$(python3 "${SCRIPT_DIR}/lib/prepare-isolated-runtime.py")
export WISPR_APP_PATH
WISPR_BIN="${WISPR_APP_PATH}/Contents/MacOS/Wispr Flow"
export WISPR_BIN_PATH="$WISPR_BIN"
python3 "${SCRIPT_DIR}/lib/verify-runtime-isolation.py" "$PROFILE_DIR"
DATA_DIR="${SCRIPT_DIR}/data"
TARGET_WORDS="${TARGET_WORDS:-${WORDS:-2100}}"
[[ "$TARGET_WORDS" =~ ^[0-9]+$ ]] && [ "$TARGET_WORDS" -gt 0 ] || { echo "Invalid word target"; exit 1; }
SERVER_OK=0
mkdir -p "$PROFILE_DIR" "$DATA_DIR"
chmod 700 "$PROFILE_DIR" "$DATA_DIR"

cleanup_and_restore() {
  if [ "$SERVER_OK" = "1" ]; then
    KEEP_PROFILE=0 bash "${SCRIPT_DIR}/lib/cleanup-isolated.sh" "$PROFILE_DIR" 2>/dev/null || true
  else
    KEEP_PROFILE=1 bash "${SCRIPT_DIR}/lib/cleanup-isolated.sh" "$PROFILE_DIR" 2>/dev/null || true
  fi
  bash "${SCRIPT_DIR}/lib/restore-audio.sh" restore 2>/dev/null || true
  bash "${SCRIPT_DIR}/lib/restore-audio.sh" builtin 2>/dev/null || true
  if [ "${SKIP_RESUME_MAIN:-}" != "1" ]; then
    bash "${SCRIPT_DIR}/lib/resume-main-wispr.sh" 2>/dev/null || true
  fi
}
trap cleanup_and_restore EXIT

echo "============================================"
echo "  Wispr Isolated Complete Flow"
echo "  Account:  ${EMAIL}"
echo "  Profile:  ${PROFILE_DIR}"
echo "  Target:   ${TARGET_WORDS} SERVER words (referral)"
echo "  (Your main Wispr account is NOT touched)"
echo "============================================"

# Step 1: Login via ego-browser (isolated task space) and capture auth token
echo ""
echo "[1/5] Signing in via ego-browser (isolated browser session)..."

HEADER=$(python3 - "$SCRIPT_DIR" "$EMAIL" "$PASSWORD" "$PROFILE_DIR" <<'PYCONFIG'
import json, sys
from pathlib import Path
root, email, password = sys.argv[1:4]
print("const config = " + json.dumps(dict(dataDir=root + "/data", profileDir=sys.argv[4], email=email, password=password)) + ";")
print("const moduleUrl = " + json.dumps(Path(root, "lib/web-auth.mjs").as_uri()) + ";")
PYCONFIG
)
TOKEN_JSON=$(ego-browser nodejs <<EOF 2>&1
${HEADER}
const { readJson, writeJson, login, refreshWorkosSession } = await import(moduleUrl);
try {
  let token = await readJson(config.dataDir + '/last-web-token.json');
  const native = (await readJson(config.profileDir + '/session.json'))?.workosSession;
  if (native?.email?.toLowerCase() === config.email.toLowerCase()) token = {
    provider: 'workos', access_token: native.accessToken, refresh_token: native.refreshToken,
    expires_at: native.expiresAt, client_id: native.clientId, user: {id:native.userId,email:native.email}
  };
  if (token?.user?.email?.toLowerCase() !== config.email.toLowerCase() || !token.access_token) token = null;
  if (token && (!Number.isFinite(token.expires_at) || token.expires_at * 1000 < Date.now() + 60000)) {
    if (token.provider === 'workos') {
      console.log('STAGE:Refreshing saved session');
      token = await refreshWorkosSession(token);
    } else token = null;
  }
  if (!token) {
    const pending = await readJson(config.dataDir + '/pending-signup.json');
    let task = null;
    for (const space of [pending?.taskSpaceId, 'wispr-signup', 'wispr-topup']) {
      if (space == null) continue;
      try { task = await taskSpace(space); break; } catch {}
    }
    if (!task) throw new Error('Cannot open a browser task space for login');
    token = JSON.parse(await login(task.page('p1'), config.email, config.password));
  }
  await writeJson(config.dataDir + '/last-web-token.json', token);
  console.log('TOKEN_OK:yes');
  console.log('TOKEN_JSON_START');
  console.log(JSON.stringify(token));
  console.log('TOKEN_JSON_END');
} catch (error) {
  console.log('ERROR:' + error.message);
  process.exitCode = 1;
}
EOF
) || true

TOKEN=$(echo "$TOKEN_JSON" | python3 -c "
import sys
text = sys.stdin.read()
if 'TOKEN_JSON_START' not in text:
    sys.exit(1)
start = text.index('TOKEN_JSON_START') + len('TOKEN_JSON_START')
end = text.index('TOKEN_JSON_END')
print(text[start:end].strip())
") || true

if [ -z "${TOKEN:-}" ]; then
  echo "ERROR: Could not obtain auth token. Check email/password/hCaptcha."
  echo "$TOKEN_JSON" | grep -E '^(ERROR|TOKEN_OK|HC_TOKEN_LEN|URL):' || true
  exit 1
fi

echo "  Auth token obtained for ${EMAIL}"
TOKEN_FILE="${DATA_DIR}/last-web-token.json"
chmod 600 "$TOKEN_FILE"

echo ""
echo "[2/5] Checking SERVER word count (referral source of truth)..."
SERVER_NOW=$(python3 "${SCRIPT_DIR}/lib/fetch-server-stats.py" --quiet --token-file "$TOKEN_FILE" 2>/dev/null || echo -1)
python3 "${SCRIPT_DIR}/lib/fetch-server-stats.py" --token-file "$TOKEN_FILE" 2>/dev/null | python3 -c "
import sys, json
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    print('  Could not parse history/stats')
    sys.exit(0)
print(f\"  Server total_words: {d.get('total_words')}\")
print(f\"  is_initialized: {d.get('is_initialized')}\")
print(f\"  words_this_week: {d.get('words_this_week')}\")
" || true
echo "  Server words now: ${SERVER_NOW}"
if ! [[ "$SERVER_NOW" =~ ^[0-9]+$ ]]; then
  echo "ERROR: Cannot verify server word count. Keeping this account for resume."
  exit 1
fi

REFERRAL_ASSOCIATED=$(python3 "${SCRIPT_DIR}/lib/fetch-server-stats.py" --quiet --referral --token-file "$TOKEN_FILE" 2>/dev/null || echo -1)
if [ "${REQUIRE_REFERRAL:-0}" = "1" ] && [ "$REFERRAL_ASSOCIATED" != "1" ]; then
  echo "ERROR: Wispr has not confirmed a referral association for ${EMAIL}."
  echo "The account is kept; resolve referral eligibility before ./wispr-resume."
  echo "Word count alone does not confirm referral credit."
  exit 1
fi

# Step 3: Inject session into isolated Wispr profile
echo ""
echo "[3/5] Creating isolated Wispr Flow profile..."

python3 - "$PROFILE_DIR" "$TOKEN" "$EMAIL" <<'PY'
import json, sys, os
profile, token, email = sys.argv[1:4]
config_path = os.path.join(profile, "config.json")

if os.path.isfile(config_path):
    with open(config_path) as f:
        config = json.load(f)
else:
    config = {"prefs": {}}

prefs = config.setdefault("prefs", {})
user = prefs.setdefault("user", {})
if user.get("email") and user["email"].lower() != email.lower():
    raise SystemExit("Refusing to overwrite a different account's profile")
user.update({
    "email": email,
    "onboardingCompleted": True,
    "postOnboardingCompleted": True,
    "speedyOnboardingAccepted": True,
    "shareUsageData": True,
    "cloudSync": True,
    "initialSubscriptionSynced": True,
})
if "pagesCompleted" not in user:
    user["pagesCompleted"] = [{"page": "welcome-basic", "completed": True}]

perms = prefs.setdefault("permissions", [])
names = {p.get("name") for p in perms}
for name in ("accessibility", "microphone"):
    if name not in names:
        perms.append({"name": name, "clicked": True, "granted": True})

auth = json.loads(token)
if auth.get("provider") == "workos":
    session = {
        "authProviderId": "workos",
        "workosSession": {
            "accessToken": auth["access_token"],
            "refreshToken": auth["refresh_token"],
            "userId": auth["user"]["id"],
            "email": auth["user"]["email"],
            "avatarUrl": None,
            "expiresAt": auth["expires_at"],
            "clientId": auth.get("client_id"),
        },
    }
    user["uuid"] = auth["user"]["id"]
else:
    session = {"sb-dodjkfqhwrzqjwkfnthl-auth-token": token}
with open(os.path.join(profile, "session.json"), "w") as f:
    json.dump(session, f, indent=2)
os.chmod(os.path.join(profile, "session.json"), 0o600)
with open(config_path, "w") as f:
    json.dump(config, f, indent=2)

stats = prefs.get("cache", {}).get("statistics", {})
print(f"  Profile updated (local cache totalWords={stats.get('totalWords', 0)})")
PY
python3 "${SCRIPT_DIR}/lib/ensure-isolated-prefs.py" "${PROFILE_DIR}/config.json"
python3 "${SCRIPT_DIR}/lib/set-blackhole-mic.py" "${PROFILE_DIR}/config.json"

if [ "$SERVER_NOW" -ge "$TARGET_WORDS" ] 2>/dev/null; then
  echo "  Already at ${SERVER_NOW} server words — skipping dictation."
  SERVER_OK=1
  FINAL_WORDS="$SERVER_NOW"
else
  # Step 4: Launch isolated Wispr Flow instance
  echo ""
  echo "[4/5] Launching isolated Wispr Flow (separate from your main account)..."

  python3 "${SCRIPT_DIR}/lib/kill-isolated-wispr.py" "$PROFILE_DIR" 2>/dev/null || true
  bash "${SCRIPT_DIR}/lib/pause-main-wispr.sh" "$PROFILE_DIR"
  sleep 2

  : > "${DATA_DIR}/isolated-wispr.log"
  nohup "$WISPR_BIN" --user-data-dir="$PROFILE_DIR" > "${DATA_DIR}/isolated-wispr.log" 2>&1 &
  ISOLATED_PID=$!
  disown "$ISOLATED_PID" 2>/dev/null || true
  echo "  Isolated Wispr PID: ${ISOLATED_PID}"
  echo "  Isolated cmd: $(ps -p "$ISOLATED_PID" -o args= 2>/dev/null || echo gone)"
  echo "  Waiting for the isolated helper to initialize..."
  bash "${SCRIPT_DIR}/lib/wait-new-log.sh" "${DATA_DIR}/isolated-wispr.log" "Helper service is ready: true" 0 90
  python3 "${SCRIPT_DIR}/lib/verify-runtime-isolation.py" "$PROFILE_DIR" "$ISOLATED_PID"

  echo ""
  echo "[5/5] Dictating until SERVER shows ${TARGET_WORDS}+ words..."

  chmod +x "${SCRIPT_DIR}/lib/dictate-fast.sh" "${SCRIPT_DIR}/lib/cleanup-isolated.sh" \
    "${SCRIPT_DIR}/lib/wait-server-words.sh"

  CYCLE=0
  while [ "$CYCLE" -lt 4 ]; do
    SERVER_NOW=$(python3 "${SCRIPT_DIR}/lib/fetch-server-stats.py" --quiet "$PROFILE_DIR" 2>/dev/null || echo -1)
    echo "  Cycle $((CYCLE + 1)): server words=${SERVER_NOW} (target ${TARGET_WORDS})"
    if [ "$SERVER_NOW" -ge "$TARGET_WORDS" ] 2>/dev/null; then
      SERVER_OK=1
      break
    fi
    LOCAL_GOAL="$TARGET_WORDS"
    echo "  Dictating until local cache >= ${LOCAL_GOAL}, then waiting for upload..."
    if ! bash "${SCRIPT_DIR}/lib/dictate-fast.sh" "$PROFILE_DIR" "${LOCAL_GOAL}"; then
      echo "ERROR: Dictation failed. Keeping this profile for ./wispr-resume."
      exit 1
    fi
    WAIT_SERVER_TIMEOUT=240 bash "${SCRIPT_DIR}/lib/wait-server-words.sh" "$PROFILE_DIR" "${TARGET_WORDS}" && {
      SERVER_OK=1
      break
    }
    CYCLE=$((CYCLE + 1))
  done

  if [ "$SERVER_OK" != "1" ]; then
    echo "  ERROR: Server still below ${TARGET_WORDS} after ${CYCLE} cycles. Profile kept for retry."
    python3 "${SCRIPT_DIR}/lib/fetch-server-stats.py" "$PROFILE_DIR" 2>/dev/null || true
    exit 1
  fi
  FINAL_WORDS=$(python3 "${SCRIPT_DIR}/lib/fetch-server-stats.py" --quiet "$PROFILE_DIR" 2>/dev/null || echo 0)
fi

if ! [[ "${FINAL_WORDS:-}" =~ ^[0-9]+$ ]] || [ "$FINAL_WORDS" -lt "$TARGET_WORDS" ]; then
  SERVER_OK=0
  echo "ERROR: Final server count is unconfirmed/below target. Profile kept; resume the same account."
  exit 1
fi

python3 - "$DATA_DIR/completions.json" "$EMAIL" "$PROFILE_DIR" "$FINAL_WORDS" "$REFERRAL_ASSOCIATED" <<'PY'
import json, sys
from datetime import datetime, timezone
path, email, profile = sys.argv[1:4]
try:
    with open(path) as f:
        data = json.load(f)
except FileNotFoundError:
    data = []
record = {
    "email": email,
    "profileDir": profile,
    "serverTotalWords": int(sys.argv[4]) if len(sys.argv) > 4 else 0,
    "completedAt": datetime.now(timezone.utc).isoformat(),
    "isolated": True,
    "serverConfirmed": True,
    "referralAssociated": sys.argv[5] == "1",
    "cleanedUp": True
}
existing = next((i for i, item in enumerate(data) if item.get("email", "").lower() == email.lower()), None)
if existing is None:
    data.append(record)
else:
    data[existing] = record
with open(path, "w") as f:
    json.dump(data, f, indent=2)
PY

echo ""
echo "============================================"
echo "  COMPLETE"
echo "  Account:           ${EMAIL}"
echo "  SERVER totalWords: ${FINAL_WORDS} (target ${TARGET_WORDS})"
echo "  Isolated profile deleted. Main account untouched."
echo "============================================"
