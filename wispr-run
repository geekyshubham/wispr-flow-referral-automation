#!/usr/bin/env bash
# Full pipeline: temp email -> referral signup -> verify -> isolated Wispr login -> 2100-word dictation.
# Usage: ./wispr-run [N]
#   N = number of accounts (default 1)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
N="${1:-1}"
TARGET_WORDS="${TARGET_WORDS:-2100}"
export TARGET_WORDS

if ! [[ "$N" =~ ^[0-9]+$ ]] || [ "$N" -lt 1 ]; then
  echo "Usage: $0 [N]"
  echo "  Creates N temp-mail accounts via referral, then dictates ${TARGET_WORDS} words each."
  exit 1
fi

chmod +x "${SCRIPT_DIR}/wispr-test" "${SCRIPT_DIR}/wispr-resume" \
  "${SCRIPT_DIR}/wispr-complete-flow" "${SCRIPT_DIR}/lib/"*.sh 2>/dev/null || true

echo "============================================"
echo "  Wispr full flow"
echo "  Accounts: ${N}"
echo "  Referral: ${REFERRAL_CODE:-SHUBHAM2270}"
echo "  Word target: ${TARGET_WORDS}"
echo "============================================"

# Signup + verify (dictation is handled below per verified account)
"${SCRIPT_DIR}/wispr-test" "$N" --no-dictation

ACCOUNTS_FILE="${SCRIPT_DIR}/data/accounts.json"
if [ ! -f "$ACCOUNTS_FILE" ]; then
  echo "ERROR: No accounts file at ${ACCOUNTS_FILE}"
  exit 1
fi

python3 - "$ACCOUNTS_FILE" "$SCRIPT_DIR" "$TARGET_WORDS" <<'PY'
import json, subprocess, sys, os
path, root, target = sys.argv[1:4]
with open(path) as f:
    accounts = json.load(f)
verified = [a for a in accounts if a.get("verified") and a.get("email") and a.get("password")]
if not verified:
    print("ERROR: No verified accounts. If hCaptcha handed off, run ./wispr-resume <task-space> then re-run.")
    sys.exit(1)
# Run complete flow for the latest verified account(s) from this file — last N unique emails
seen = set()
todo = []
for a in reversed(verified):
    if a["email"] in seen:
        continue
    seen.add(a["email"])
    todo.append(a)
    if len(todo) >= 20:
        break
todo.reverse()
print(f"Verified accounts to dictate: {len(todo)}")
for a in todo:
    print(f"\n>>> Isolated login + dictation for {a['email']}")
    env = os.environ.copy()
    env["TARGET_WORDS"] = target
    rc = subprocess.call(
        [os.path.join(root, "wispr-complete-flow"), a["email"], a["password"]],
        env=env,
    )
    if rc != 0:
        print(f"WARNING: complete-flow exited {rc} for {a['email']}")
        sys.exit(rc)
PY

echo ""
echo "Full flow finished."
