#!/usr/bin/env bash
# Full pipeline: create N accounts, dictate W words on each, loop until all are done.
# Usage:
#   ./wispr-run --accounts 3 --words 2100
#   ./wispr-run 3 2100
#   ACCOUNTS=3 WORDS=2100 ./wispr-run
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ACCOUNTS="${ACCOUNTS:-1}"
WORDS="${WORDS:-${TARGET_WORDS:-2100}}"
REFERRAL_CODE="${REFERRAL_CODE:-SHUBHAM2270}"

while [ $# -gt 0 ]; do
  case "$1" in
    --accounts|-n) ACCOUNTS="${2:?}"; shift 2 ;;
    --words|-w) WORDS="${2:?}"; shift 2 ;;
    --referral) REFERRAL_CODE="${2:?}"; shift 2 ;;
    --help|-h)
      echo "Usage: $0 [--accounts N] [--words W] [--referral CODE]"
      echo "       $0 [N] [W]"
      echo "  N  number of temp-mail accounts to create (default 1)"
      echo "  W  dictated words per account (default 2100)"
      exit 0
      ;;
    [0-9]*)
      if [ "$ACCOUNTS" = "1" ] && [ -z "${ACCOUNTS_SET:-}" ]; then
        ACCOUNTS="$1"
        ACCOUNTS_SET=1
      else
        WORDS="$1"
      fi
      shift
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done

if ! [[ "$ACCOUNTS" =~ ^[0-9]+$ ]] || [ "$ACCOUNTS" -lt 1 ]; then
  echo "accounts must be a positive integer"
  exit 1
fi
if ! [[ "$WORDS" =~ ^[0-9]+$ ]] || [ "$WORDS" -lt 1 ]; then
  echo "words must be a positive integer"
  exit 1
fi

export SKIP_RESUME_MAIN=1
export REFERRAL_CODE TARGET_WORDS="$WORDS" WORDS
chmod +x "${SCRIPT_DIR}/wispr-test" "${SCRIPT_DIR}/wispr-resume" \
  "${SCRIPT_DIR}/wispr-complete-flow" "${SCRIPT_DIR}/lib/"*.sh 2>/dev/null || true

restore_all() {
  bash "${SCRIPT_DIR}/lib/restore-audio.sh" restore 2>/dev/null || true
  bash "${SCRIPT_DIR}/lib/restore-audio.sh" builtin 2>/dev/null || true
  bash "${SCRIPT_DIR}/lib/resume-main-wispr.sh" 2>/dev/null || true
}
trap restore_all EXIT

bash "${SCRIPT_DIR}/lib/restore-audio.sh" save 2>/dev/null || true

echo "============================================"
echo "  wispr-flow-referral-automation"
echo "  Accounts to finish: ${ACCOUNTS}"
echo "  Words per account:  ${WORDS}"
echo "  Referral:           ${REFERRAL_CODE}"
echo "============================================"

DATA_DIR="${SCRIPT_DIR}/data"
ACCOUNTS_FILE="${DATA_DIR}/accounts.json"
mkdir -p "$DATA_DIR"
[ -f "$ACCOUNTS_FILE" ] || echo "[]" > "$ACCOUNTS_FILE"

DONE=0
ATTEMPT=0
MAX_ATTEMPTS=$((ACCOUNTS * 4))

while [ "$DONE" -lt "$ACCOUNTS" ] && [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]; do
  ATTEMPT=$((ATTEMPT + 1))
  echo ""
  echo "======== Slot $((DONE + 1))/${ACCOUNTS}  (attempt ${ATTEMPT}/${MAX_ATTEMPTS}) ========"

  BEFORE=$(python3 -c "import json; print(len(json.load(open('${ACCOUNTS_FILE}'))))")
  "${SCRIPT_DIR}/wispr-test" 1 --no-dictation || true
  AFTER=$(python3 -c "import json; print(len(json.load(open('${ACCOUNTS_FILE}'))))")

  NEW=$(python3 - "$ACCOUNTS_FILE" "$BEFORE" <<'PY'
import json, sys
path, before = sys.argv[1], int(sys.argv[2])
accounts = json.load(open(path))
new = accounts[before:]
for a in new:
    if a.get("verified") and a.get("email") and a.get("password"):
        print(a["email"] + "\t" + a["password"])
        break
PY
)

  if [ -z "$NEW" ]; then
    echo "  Signup not verified this attempt (often hCaptcha). Continuing loop..."
    echo "  If ego-browser handed off, solve captcha then: ./wispr-resume <task-space>"
    sleep 3
    continue
  fi

  EMAIL=$(printf '%s' "$NEW" | cut -f1)
  PASSWORD=$(printf '%s' "$NEW" | cut -f2-)
  echo "  Verified ${EMAIL} — dictating ${WORDS} words in isolated Wispr..."

  if TARGET_WORDS="$WORDS" "${SCRIPT_DIR}/wispr-complete-flow" "$EMAIL" "$PASSWORD"; then
    DONE=$((DONE + 1))
    echo "  Finished ${DONE}/${ACCOUNTS} accounts."
  else
    echo "  Dictation/login failed for ${EMAIL} — will try another account."
    bash "${SCRIPT_DIR}/lib/cleanup-isolated.sh" \
      "${SCRIPT_DIR}/profiles/$(echo "$EMAIL" | cut -d@ -f1)" 2>/dev/null || true
  fi

  bash "${SCRIPT_DIR}/lib/restore-audio.sh" restore 2>/dev/null || true
  bash "${SCRIPT_DIR}/lib/restore-audio.sh" builtin 2>/dev/null || true
done

echo ""
if [ "$DONE" -ge "$ACCOUNTS" ]; then
  echo "DONE: ${DONE}/${ACCOUNTS} accounts each reached ${WORDS} words."
else
  echo "INCOMPLETE: ${DONE}/${ACCOUNTS} accounts finished after ${ATTEMPT} attempts."
  exit 1
fi
