#!/usr/bin/env bash
# Create/verify accounts, streaming progress and preserving human handoffs.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/lib/env.sh"
if ! python3 "${SCRIPT_DIR}/lib/job-lock.py" --is-held "$SCRIPT_DIR"; then
  exec python3 "${SCRIPT_DIR}/lib/job-lock.py" "$SCRIPT_DIR" "${SCRIPT_DIR}/wispr-test" "$@"
fi
N=1
SKIP_DICTATION=false
FRESH="${WISPR_FRESH_SIGNUP:-0}"
for arg in "$@"; do
  case "$arg" in
    --no-dictation) SKIP_DICTATION=true ;;
    --fresh) FRESH=1 ;;
    [0-9]*) N="$arg" ;;
    *) echo "Usage: $0 <N> [--no-dictation] [--fresh]"; exit 1 ;;
  esac
done
[[ "$N" =~ ^[0-9]+$ ]] && [ "$N" -gt 0 ] || exit 1
if [ "$FRESH" = "1" ]; then
  node "${SCRIPT_DIR}/lib/referral-status.mjs" "$SCRIPT_DIR/data/pending-signup.json" --fresh "${REFERRAL_CODE:-SHUBHAM3680}"
else
  node "${SCRIPT_DIR}/lib/referral-status.mjs" "$SCRIPT_DIR/data/pending-signup.json"
fi
python3 "${SCRIPT_DIR}/lib/check-network.py" "${MAIL_PROVIDER:-maildrop}"
mkdir -p "${SCRIPT_DIR}/data"
for ((i=1; i<=N; i++)); do
  HEADER=$(python3 - "$SCRIPT_DIR" "$i" "$N" "$SKIP_DICTATION" "$FRESH" <<'PYCONFIG'
import json, os, sys
from pathlib import Path
root, index, count, skip, fresh = sys.argv[1:]
space = os.environ.get("WISPR_TASK_SPACE", "wispr-signup")
config = dict(dataDir=root + "/data", index=int(index),
              mailProvider=os.environ.get('MAIL_PROVIDER', 'maildrop'),
              mailWaitSeconds=int(os.environ.get('MAIL_WAIT_SECONDS', '0')),
              referralCode=os.environ.get("REFERRAL_CODE", "SHUBHAM3680"),
              targetWords=int(os.environ.get("TARGET_WORDS", "2100")),
              remainingAccounts=int(os.environ.get("REMAINING_ACCOUNTS", str(int(count) - int(index) + 1))),
              skipDictation=skip == 'true' and os.environ.get('WISPR_BATCH_DICTATION') != '1',
              requireReferral=os.environ.get('REQUIRE_REFERRAL') == '1' or os.environ.get('WISPR_BATCH_DICTATION') == '1',
              continueBatch=int(index) > 1 or os.environ.get('WISPR_CONTINUE_BATCH') == '1',
              fresh=fresh == '1',
              taskSpace=int(space) if space.isdigit() else space)
print("const config = " + json.dumps(config) + ";")
print("const moduleUrl = " + json.dumps(Path(root, "lib/web-auth.mjs").as_uri()) + ";")
PYCONFIG
)
  STATUS=0
  ego-browser nodejs <<EOF | tee "${SCRIPT_DIR}/data/last-signup-raw.log" || STATUS=$?
${HEADER}
const { runSignup, readJson } = await import(moduleUrl);
const pending = await readJson(config.dataDir + '/pending-signup.json');
if (!config.fresh && pending && (!pending.completed || (pending.remainingAccounts > 0 && !config.continueBatch))) {
  console.log('ERROR:An unfinished account/batch is saved. Continue it with ./wispr-resume, or use --fresh to archive it and start with a NEW email.');
  process.exitCode = 75;
} else {
  const task = await taskSpace(config.taskSpace);
  process.exitCode = await runSignup(config, task);
}
EOF
  [ "$STATUS" -eq 0 ] || exit "$STATUS"
  if [ "$SKIP_DICTATION" = false ]; then
    FIELDS=$(python3 - "$SCRIPT_DIR/data/pending-signup.json" <<'PYFIELDS'
import json, sys
p = json.load(open(sys.argv[1]))
print(p['email'] + "\t" + p['password'])
PYFIELDS
)
    IFS=$'\t' read -r EMAIL PASSWORD <<< "$FIELDS"
    "${SCRIPT_DIR}/wispr-complete-flow" "$EMAIL" "$PASSWORD"
  fi
  if [ "${WISPR_BATCH_DICTATION:-0}" != "1" ]; then
    python3 - "$SCRIPT_DIR/data/pending-signup.json" "$((N - i))" <<'PYCOMPLETE'
import json, os, sys, tempfile
path, remaining = sys.argv[1:]
with open(path) as stream:
    pending = json.load(stream)
pending.update(completed=True, remainingAccounts=int(remaining))
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.pending-')
with os.fdopen(fd, 'w') as stream:
    json.dump(pending, stream, indent=2)
os.replace(temporary, path)
PYCOMPLETE
  fi
done
if [ "${WISPR_BATCH_DICTATION:-0}" != "1" ]; then
  bash "${SCRIPT_DIR}/lib/close-ego-wispr-spaces.sh"
fi
