#!/usr/bin/env bash
# Stop the background job (if running) and reset mic/speakers/Wispr.
set -u
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
chmod +x "${SCRIPT_DIR}/lib/cleanup-all.sh" "${SCRIPT_DIR}/lib/restore-audio.sh" \
  "${SCRIPT_DIR}/lib/close-ego-wispr-spaces.sh" 2>/dev/null || true
exec bash "${SCRIPT_DIR}/lib/cleanup-all.sh" --stop-job
